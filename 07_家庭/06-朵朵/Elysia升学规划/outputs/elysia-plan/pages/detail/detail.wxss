/* pages/detail/detail.wxss */

.page-detail {
  padding-bottom: 60rpx;
}

/* 头部 */
.detail-header {
  padding: 48rpx 32rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.header-top {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-emoji {
  font-size: 64rpx;
  margin-right: 20rpx;
}

.header-info {
  flex: 1;
}

.header-school {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  color: #FFF;
}

.header-en {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  display: block;
  margin-bottom: 8rpx;
}

.header-meta {
  display: flex;
  gap: 16rpx;
}

.header-rank {
  font-size: 22rpx;
  background: rgba(255,255,255,0.2);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #FFF;
}

.header-city {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
}

.header-match {
  text-align: center;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255,255,255,0.2);
}

.match-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  display: block;
  margin-bottom: 8rpx;
}

.match-stars {
  font-size: 36rpx;
  color: #FDCB6E;
  letter-spacing: 8rpx;
}

/* 专业卡片 */
.program-card {
  margin-top: -16rpx;
  position: relative;
  z-index: 2;
}

.program-name-cn {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  color: #2D3436;
  margin-bottom: 4rpx;
}

.program-name-en {
  font-size: 24rpx;
  color: #B2BEC3;
  display: block;
  margin-bottom: 16rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

/* 申请要求 */
.req-section {
  margin-top: 8rpx;
}

.req-title {
  font-size: 28rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 20rpx;
  color: #2D3436;
}

.req-item {
  display: flex;
  margin-bottom: 20rpx;
  align-items: flex-start;
}

.req-label {
  font-size: 24rpx;
  color: #636E72;
  width: 160rpx;
  flex-shrink: 0;
}

.req-value {
  font-size: 26rpx;
  color: #2D3436;
  flex: 1;
  line-height: 1.5;
}

.req-value.highlight {
  color: #E74C3C;
  font-weight: 700;
}

/* 点评 */
.comment-section {
  background: linear-gradient(135deg, #F0E6FF, #FFE6F0);
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.comment-title {
  font-size: 26rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
  color: #6C5CE7;
}

.comment-body {
  font-size: 26rpx;
  color: #2D3436;
  line-height: 1.8;
}

/* 链接按钮 */
.link-section {
  margin-top: 16rpx;
}

.link-btn {
  width: 100%;
}

/* 其他专业 */
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 16rpx;
  color: #2D3436;
}

.other-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.other-item:last-child {
  border-bottom: none;
}

.other-name {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  color: #2D3436;
  margin-bottom: 4rpx;
}

.other-en {
  font-size: 22rpx;
  color: #B2BEC3;
  display: block;
  margin-bottom: 4rpx;
}

.other-level {
  font-size: 24rpx;
  color: #636E72;
}
