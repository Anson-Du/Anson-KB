/* pages/action/action.wxss */

.page-action {
  padding-bottom: 60rpx;
}

/* 进度头部 */
.progress-header {
  padding: 48rpx 32rpx;
  border-radius: 0 0 48rpx 48rpx;
  text-align: center;
}

.progress-title {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  color: #FFF;
  margin-bottom: 8rpx;
}

.progress-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  display: block;
  margin-bottom: 32rpx;
}

.progress-ring {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.ring-bg {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-fill {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.ring-inner {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(108, 92, 231, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.ring-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFF;
}

.ring-unit {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 16rpx;
}

.progress-detail {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

/* 时间线 */
.timeline {
  padding: 24rpx 24rpx 0;
}

.timeline-item {
  display: flex;
  margin-bottom: 0;
}

.month-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 80rpx;
  flex-shrink: 0;
}

.month-emoji {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.month-line {
  width: 4rpx;
  flex: 1;
  background: linear-gradient(to bottom, #6C5CE7, #FD79A8);
  border-radius: 2rpx;
  min-height: 40rpx;
}

.month-content {
  flex: 1;
  margin-left: 16rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.month-header {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.month-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
}

.month-label {
  font-size: 24rpx;
  color: #6C5CE7;
  background: #F0E6FF;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 任务列表 */
.task-list {
  margin-top: 8rpx;
}

.task-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F8F8F8;
  transition: all 0.3s;
}

.task-item:last-child {
  border-bottom: none;
}

.task-item.done {
  opacity: 0.6;
}

.task-check {
  margin-right: 16rpx;
  flex-shrink: 0;
  padding-top: 2rpx;
}

.check-icon {
  font-size: 32rpx;
}

.task-text {
  font-size: 26rpx;
  color: #2D3436;
  line-height: 1.6;
  flex: 1;
}

.task-text.line-through {
  text-decoration: line-through;
  color: #B2BEC3;
}

/* 重置 */
.reset-section {
  text-align: center;
  padding: 24rpx;
}

.reset-btn {
  display: inline-block;
  font-size: 24rpx;
  color: #B2BEC3;
  border-color: #DDD;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 20rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #B2BEC3;
}
